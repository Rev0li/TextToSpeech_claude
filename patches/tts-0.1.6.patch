 # Kill any in-flight paplay that matches our speak invocation.
 # Idempotent: pkill on nothing is a no-op.
 tts_kill_inflight() {
+    _tts_kill_tagged "tts-speak:"
     pkill -f "paplay --raw --format=s16le --rate=22050" 2>/dev/null || true
 }
+
+# rev0li : coupe seulement les lectures d'une session (en cours ou en
+# attente dans la file), sans toucher à celles des autres terminaux.
+tts_kill_session() {
+    [ -n "$1" ] || return 0
+    _tts_kill_tagged "tts-speak:$1"
+}
+
+# Tue le groupe de processus (setsid) de chaque lecture dont $0 commence
+# par $1 : flock en attente, piper et paplay partent avec. On vérifie
+# argv[3] (bash -c SCRIPT $0) pour ne viser que nos propres lectures.
+_tts_kill_tagged() {
+    local pid args
+    for pid in $(pgrep -x bash 2>/dev/null); do
+        args=()
+        mapfile -d '' -t args 2>/dev/null < "/proc/$pid/cmdline"
+        case "${args[3]:-}" in "$1"*) ;; *) continue ;; esac
+        [ "$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')" = "$pid" ] || continue
+        kill -- "-$pid" 2>/dev/null || true
+    done
+}
