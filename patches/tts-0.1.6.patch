+# rev0li : Claude Code récent donne directement le texte du dernier message
+# (last_assistant_message). On le préfère à la transcription, qui peut ne
+# pas encore contenir la réponse finale quand le hook démarre.
+if command -v jq >/dev/null 2>&1; then
+    TTS_SESSION="$(printf '%s' "$HOOK_JSON" | jq -r '.session_id // empty' 2>/dev/null)"
+    export TTS_SESSION
+    latest_text="$(printf '%s' "$HOOK_JSON" | jq -r '.last_assistant_message // empty | strings' 2>/dev/null)"
+    if [ -n "$latest_text" ]; then
+        tts_speak "$latest_text"
+        exit 0
+    fi
+fi
+
