+# rev0li : secours pour les anciennes versions de Claude Code. On attend
+# (3 s max) que la dernière entrée assistant de la transcription soit du
+# texte, c'est-à-dire que la réponse finale y soit écrite.
+for _ in $(seq 15); do
+    jq -es '[.[] | select(.message.role == "assistant")] | last
+            | .message.content | type == "array" and any(.[]; .type == "text")' \
+        "$transcript_path" >/dev/null 2>&1 && break
+    sleep 0.2
+done
+
